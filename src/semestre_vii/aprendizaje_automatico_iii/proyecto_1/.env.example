# Copia este archivo como .env en esta carpeta (Git lo ignora). Lo leen las clases de configuracion.py.
# Sólo precargar.py usa la clave, y sólo la primera vez, para descargar Mexican Bread v3.
ROBOFLOW_API_KEY=

# Opcionales: sin estas líneas rigen las clases de app.py, precargar.py y configuracion.py.
# Los grupos se separan con doble guion bajo. En app.py también valen como CLI: --portero.tamano x

# Comunes
# DISPOSITIVO=auto
# GALERIA=/ruta/a/otra/galeria

# Demo (app.py)
# FUENTE=0
# PORTERO__TAMANO=l
# PORTERO__CONFIANZA=0.35
# PORTERO__IMGSZ=640
# UMBRAL=0.6          # Sin esta línea no hay rechazo: siempre gana la clase más votada.

# Precarga (precargar.py)
# CONSTRUCCION__DATASET=/ruta/a/mexican-v3
# CONSTRUCCION__CLASES=["Bolillo","Concha","Cuernito","Dona"]
# CONSTRUCCION__GRIS=true
